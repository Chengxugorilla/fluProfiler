{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# H3N2 serum prediction scatter plots\n",
    "\n",
    "Three separate plots compare true HI label (x-axis) against prediction (y-axis), pooled over the 10 serum-split seeds. Nextflu and Adaboost use their `without_name` predictions; SCMS-FiLM-H3 uses its test prediction `mean`. The fitted-line slope and Pearson correlation are both reported because slope is not itself a correlation coefficient."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from __future__ import annotations\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def find_project_root(start: Path) -> Path:\n",
    "    for candidate in (start, *start.parents):\n",
    "        if (candidate / 'results').is_dir() and (candidate / 'paper').is_dir():\n",
    "            return candidate\n",
    "    raise FileNotFoundError('Could not find the fluProfiler project root.')\n",
    "\n",
    "\n",
    "PROJECT_ROOT = find_project_root(Path.cwd().resolve())\n",
    "RESULTS_ROOT = PROJECT_ROOT / 'results/H1H3_HA1_v1.0/20260717_164256'\n",
    "OUTPUT_DIR = PROJECT_ROOT / 'paper/data/H3N2_serum_prediction_scatters_without_name'\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "SEEDS = range(10)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_predictions(model: str, seed: int) -> pd.DataFrame:\n",
    "    if model == 'Nextflu':\n",
    "        path = RESULTS_ROOT / 'Nextflu/serum' / f'seed_{seed}' / 'H3N2/predictions.csv'\n",
    "        frame = pd.read_csv(path)\n",
    "        frame = frame.loc[(frame['Type'] == 'H3N2') & frame['pred_without_name'].notna(), ['label', 'pred_without_name']].copy()\n",
    "        frame.columns = ['label', 'prediction']\n",
    "    elif model == 'Adaboost':\n",
    "        path = RESULTS_ROOT / 'Adaboost/serum' / f'seed_{seed}' / 'H3N2/predictions.csv'\n",
    "        frame = pd.read_csv(path)\n",
    "        frame = frame.loc[(frame['Type'] == 'H3N2') & (frame['split'] == 'test') & frame['prediction_without_name'].notna(), ['label', 'prediction_without_name']].copy()\n",
    "        frame.columns = ['label', 'prediction']\n",
    "    elif model == 'SCMS-FiLM-H3':\n",
    "        path = (RESULTS_ROOT / 'SCMS-FiLM-H3-Epoch50/serum' / f'seed_{seed}'\n",
    "                / 'subtype/H3N2_seed42/predictions_test.csv')\n",
    "        frame = pd.read_csv(path)\n",
    "        frame = frame.loc[frame['Type'] == 'H3N2', ['label', 'mean']].copy()\n",
    "        frame.columns = ['label', 'prediction']\n",
    "    else:\n",
    "        raise ValueError(f'Unsupported model: {model}')\n",
    "\n",
    "    frame['seed'] = seed\n",
    "    frame['model'] = model\n",
    "    return frame.dropna(subset=['label', 'prediction'])\n",
    "\n",
    "\n",
    "MODELS = ['SCMS-FiLM-H3', 'Nextflu', 'Adaboost']\n",
    "all_predictions = pd.concat(\n",
    "    [load_predictions(model, seed) for model in MODELS for seed in SEEDS],\n",
    "    ignore_index=True,\n",
    ")\n",
    "display(all_predictions.groupby('model').agg(rows=('label', 'size'), seeds=('seed', 'nunique')))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "COLORS = {'SCMS-FiLM-H3': '#4C78A8', 'Nextflu': '#B79A20', 'Adaboost': '#59A14F'}\n",
    "\n",
    "\n",
    "def plot_model_scatter(model: str) -> None:\n",
    "    frame = all_predictions.loc[all_predictions['model'] == model]\n",
    "    x = frame['label'].to_numpy(dtype=float)\n",
    "    y = frame['prediction'].to_numpy(dtype=float)\n",
    "    slope, intercept = np.polyfit(x, y, 1)\n",
    "    pearson_r = float(np.corrcoef(x, y)[0, 1])\n",
    "    mae = float(np.mean(np.abs(y - x)))\n",
    "    low = float(min(x.min(), y.min()))\n",
    "    high = float(max(x.max(), y.max()))\n",
    "    padding = (high - low) * 0.04\n",
    "    limits = (low - padding, high + padding)\n",
    "    line_x = np.linspace(*limits, 200)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(5.2, 5.0), dpi=300)\n",
    "    ax.scatter(x, y, s=5, alpha=0.08, color=COLORS[model], linewidths=0, rasterized=True)\n",
    "    ax.plot(line_x, line_x, '--', color='#777777', linewidth=1.2, label='identity')\n",
    "    ax.plot(line_x, slope * line_x + intercept, color='black', linewidth=1.6, label='linear fit')\n",
    "    ax.set_xlim(limits); ax.set_ylim(limits)\n",
    "    ax.set_aspect('equal', adjustable='box')\n",
    "    ax.set_xlabel('Observed HI label')\n",
    "    ax.set_ylabel('Predicted HI label')\n",
    "    ax.set_title(f'H3N2 serum split: {model}')\n",
    "    ax.legend(frameon=False, loc='upper left')\n",
    "    ax.text(0.98, 0.04, f'n = {len(frame):,}\\nslope = {slope:.3f}\\nPearson r = {pearson_r:.3f}\\nMAE = {mae:.3f}',\n",
    "            transform=ax.transAxes, ha='right', va='bottom',\n",
    "            bbox={'boxstyle': 'round,pad=0.35', 'facecolor': 'white', 'edgecolor': '#BBBBBB', 'alpha': 0.9})\n",
    "    ax.spines['top'].set_visible(False); ax.spines['right'].set_visible(False)\n",
    "    fig.tight_layout()\n",
    "    output_path = OUTPUT_DIR / f'{model.lower().replace("-", "_")}_scatter.png'\n",
    "    fig.savefig(output_path, bbox_inches='tight')\n",
    "    print(f'{model}: slope={slope:.4f}, Pearson r={pearson_r:.4f}, MAE={mae:.4f}')\n",
    "    print(f'Saved: {output_path}')\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "for model in MODELS:\n",
    "    plot_model_scatter(model)\n"
   ]
  }
 ],
